@{
    ViewData["Title"] = "Mensajes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .chat-list {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .chat-item {
        padding: 12px 15px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .chat-item:hover {
            background-color: #f8f9fa;
        }

    .chat-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
    }

    .chat-user {
        font-weight: bold;
        color: #333;
    }

    .chat-time {
        font-size: 0.8em;
        color: #6c757d;
    }

    .chat-message {
        color: #495057;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dx-datagrid-header-panel {
        display: none;
    }

    .dx-command-edit {
        display: none !important;
    }
    /* Nuevos estilos para agrupación */
    .conversation-group {
        margin-bottom: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        overflow: hidden;
    }

    .conversation-header {
        background-color: #f5f5f5;
        padding: 8px 15px;
        font-weight: bold;
        border-bottom: 1px solid #ddd;
    }

    .conversation-messages {
        max-height: 300px;
        overflow-y: auto;
    }
</style>

<h2>Mensajes</h2>

@(Html.DevExtreme().DataGrid<ProyectoLinkedinMVC.Models.Mensaje>()
    .ID("chatGrid")
    .DataSource(ds => ds.WebApi()
        .Controller("Mensaje")
        .LoadAction("Get")
        .Key("Id")
    )
    .RemoteOperations(true)
    .ShowBorders(false)
    .RowAlternationEnabled(false)
    .ColumnAutoWidth(true)
    .Columns(columns => {
        columns.Add()
            .CellTemplate(@<text>
                <div class="chat-item">
                    <div class="chat-header">
                        <span class="chat-user"><%- data.Remitente %> → <%- data.Destinatario %></span>
                        <span class="chat-time"><%= formatDate(data.Fechadeenvio) %></span>
                    </div>
                    <div class="chat-message"><%- data.Contenido %></div>
                </div>
            </text>)
            .AllowSorting(false);
    })
    .Selection(s => s.Mode(SelectionMode.Single))
    .OnSelectionChanged("onChatSelected")
    .Paging(p => p.PageSize(20))
    .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
    .FilterRow(f => f.Visible(false))
    .HeaderFilter(f => f.Visible(false))
    .GroupPanel(p => p.Visible(false))
    .SearchPanel(f => f.Visible(false))
    .Editing(e => e
        .AllowAdding(false)
        .AllowUpdating(false)
        .AllowDeleting(false)
    )
    .OnContentReady("groupConversations")
)

<script>
    function formatDate(date) {
        if (!date) return '';
        const d = new Date(date);
        return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    function onChatSelected(e) {
        const selectedChat = e.selectedRowsData[0];
        if (selectedChat) {
            console.log("Chat seleccionado:", selectedChat);
        }
    }

    function groupConversations(e) {
        const grid = e.component;
        const dataSource = grid.getDataSource();

        dataSource.load().then(function (data) {
            // Agrupar mensajes por conversación (combinación única de remitente y destinatario)
            const conversations = {};

            data.forEach(function (message) {
                // Creamos una clave única sin importar el orden de los participantes
                const participants = [message.Remitente_Id, message.Destinatario_Id].sort().join('-');
                const conversationKey = participants + '-' + [message.Remitente, message.Destinatario].sort().join('-');

                if (!conversations[conversationKey]) {
                    conversations[conversationKey] = {
                        remitente: message.Remitente,
                        destinatario: message.Destinatario,
                        remitenteId: message.Remitente_Id,
                        destinatarioId: message.Destinatario_Id,
                        messages: [],
                        lastDate: message.Fechadeenvio
                    };
                }

                conversations[conversationKey].messages.push(message);
                if (new Date(message.Fechadeenvio) > new Date(conversations[conversationKey].lastDate)) {
                    conversations[conversationKey].lastDate = message.Fechadeenvio;
                }
            });

            // Ordenar conversaciones por fecha del último mensaje
            const sortedConversations = Object.values(conversations).sort(function (a, b) {
                return new Date(b.lastDate) - new Date(a.lastDate);
            });

            // Reconstruir el DataGrid con las conversaciones agrupadas
            const $gridContainer = $(grid.element());
            $gridContainer.empty();

            sortedConversations.forEach(function (conversation) {
                const $group = $(
                    `<div class="conversation-group">
                        <div class="conversation-header">
                            ${conversation.remitente} ↔ ${conversation.destinatario}
                            <span class="chat-time">${formatDate(conversation.lastDate)}</span>
                        </div>
                        <div class="conversation-messages"></div>
                    </div>`
                );

                conversation.messages.sort(function (a, b) {
                    return new Date(a.Fechadeenvio) - new Date(b.Fechadeenvio);
                }).forEach(function (message) {
                    $group.find('.conversation-messages').append(`
                        <div class="chat-item">
                            <div class="chat-message">${message.Contenido}</div>
                            <div class="chat-time">${formatDate(message.Fechadeenvio)}</div>
                        </div>
                    `);
                });

                $gridContainer.append($group);
            });
        });
    }
</script>
