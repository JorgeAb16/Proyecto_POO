@{
    ViewData["Title"] = "Reaccion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center text-primary mb-4">Reaccion</h2>

@(Html.DevExtreme().DataGrid<ProyectoLinkedinMVC.Models.Reaccion>()
    .DataSource(ds => ds.WebApi()
        .Controller("Reaccion")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("Id")
    )
// Configuración Responsive y de Estilo
.Width("100%")
.ColumnAutoWidth(true)
.AllowColumnResizing(true)
.ColumnMinWidth(120)
.ColumnResizingMode(ColumnResizingMode.Widget)
.ShowBorders(true)
.HoverStateEnabled(true)
.ShowColumnLines(true)
.ShowRowLines(true)
.RowAlternationEnabled(true)
.WordWrapEnabled(true)

// Configuración de Operaciones
.RemoteOperations(true)
.Scrolling(s => s.Mode(GridScrollingMode.Virtual))
.ColumnHidingEnabled(true)

// Configuración de Filtrado y Búsqueda
.FilterRow(f => f.Visible(true).ApplyFilter(GridApplyFilterMode.Auto))
.HeaderFilter(f => f.Visible(true))
.FilterPanel(f => f.Visible(true))
.SearchPanel(f => f.Visible(true).Width(300).Placeholder("Buscar..."))

// Configuración de Agrupación
.GroupPanel(p => p.Visible(true))
.Grouping(g => g.AutoExpandAll(false))

// Configuración de Paginación
.Paging(p => p.PageSize(10))
.Pager(p => p
    .ShowPageSizeSelector(true)
    .AllowedPageSizes(new[] { 5, 10, 20 })
    .ShowInfo(true)
    .ShowNavigationButtons(true))
    .Columns(columns => {

        columns.AddFor(m => m.Id);

        columns.AddFor(m => m.NombreReaccion);

        columns.AddFor(m => m.Contenido);

        columns.AddFor(m => m.UsuarioID);
        columns.Add()
        .DataField("NombreUsuario")
        .Caption("Nombre de Usuario");

        columns.AddFor(m => m.PublicacionID);
        columns.Add()
        .DataField("publicacionTitulo")
        .Caption("Titulo de Publicacion");

        columns.AddFor(m => m.ComentarioID);
        columns.Add()
        .DataField("ContenidoComentario")
        .Caption("Contenido de Comentario");

    })
        .Editing(e => e
        .Mode(GridEditMode.Popup)
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
        .UseIcons(true)
        .Popup(p => p
            .Title("Editar Registro")
            .Width("70%")
            .Height("auto")
        )
    )
    .OnInitialized("adjustGridLayout")
)
